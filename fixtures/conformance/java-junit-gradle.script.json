{
  "//": "P3-06 Gradle gate. Identical packaged manifest/executable truth to Maven; only the project-under-test cwd changes.",
  "name": "java-junit-gradle",
  "manifest": "../../adapters/java-junit/package/crucible-adapter.yaml",
  "cwd": "./gradle-basic",
  "resolveBin": {
    "crucible-adapter-java-junit": {
      "command": "node",
      "prefixArgs": ["../../adapters/java-junit/package/java-junit.mjs"]
    }
  },
  "cases": "./java-junit-gradle.cases.json",
  "timeoutMs": 180000,
  "package": {
    "files": [
      "../../adapters/java-junit/package/java-junit.mjs",
      "../../adapters/java-junit/package/crucible-adapter.yaml"
    ]
  }
}
