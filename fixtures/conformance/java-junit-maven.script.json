{
  "//": "P3-06 Maven gate. The runner drives the shipped manifest verbatim and binds its bin name to the single packaged executable, whose embedded helper jar and wrapper bytes are pinned together.",
  "name": "java-junit-maven",
  "manifest": "../../adapters/java-junit/package/crucible-adapter.yaml",
  "cwd": "./maven-basic",
  "resolveBin": {
    "crucible-adapter-java-junit": {
      "command": "node",
      "prefixArgs": ["../../adapters/java-junit/package/java-junit.mjs"]
    }
  },
  "cases": "./java-junit-maven.cases.json",
  "timeoutMs": 180000,
  "package": {
    "files": [
      "../../adapters/java-junit/package/java-junit.mjs",
      "../../adapters/java-junit/package/crucible-adapter.yaml"
    ]
  }
}
