{
  "name": "crucible-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Crucible — humans approve artifacts, not code. Monorepo root.",
  "workspaces": [
    "core",
    "adapters/stub",
    "fixtures",
    "ci-templates"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:layering": "node scripts/check-layering.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fission-ai/openspec": "1.6.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  },
  "openspec": {
    "testedVersion": "1.6.0",
    "expectedCompatibleRange": "1.6.x",
    "policy": "Exact pin; schema commands are experimental upstream. Bump deliberately: re-run docs/design/spike-notes.md §Repro, then crucible doctor (P2+)."
  }
}
